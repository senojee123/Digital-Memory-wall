PORT=4000
# Comma separated list of allowed frontend origins (your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of this API (used to build links to locally stored uploads)
PUBLIC_API_URL=http://localhost:4000

# Leave EMPTY for local use: an embedded Postgres (PGlite) is stored in server/data, nothing to install.
# For production use a real server, e.g. postgres://user:pass@host:5432/memorywall
DATABASE_URL=
# Set to true for managed Postgres that requires SSL (Render, Neon, Supabase, RDS)
PGSSL=false

# Admin dashboard login + token signing secret
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string

# AI (optional: without a key the app falls back to simple built-in captions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Storage: "local" (server/uploads) or "s3"
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Optional: CDN / custom public base URL for the bucket
S3_PUBLIC_URL=
# Optional: for S3-compatible providers (R2, MinIO)
S3_ENDPOINT=

# Optional: USD per 1 million tokens (see Google pricing) to show a cost estimate in the admin
GEMINI_PRICE_IN=
GEMINI_PRICE_OUT=

# Optional: USD per 1 million tokens (see Google pricing) to show a cost estimate in the admin
GEMINI_PRICE_IN=
GEMINI_PRICE_OUT=
